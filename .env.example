NODE_ENV=development
PORT=3001
HOST=localhost

# Database Configuration
USE_DATABASE=false  # Set to true to use PostgreSQL, false for JSON files
DB_HOST=localhost
DB_PORT=5432
DB_NAME=awyad_mes
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=20

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# API Configuration
API_BASE_URL=/api/v1

# Base path for sub-path deployments (e.g. reverse-proxied under /me-platform).
# Leave blank (or remove) for root / subdomain deployments.
# APP_BASE_PATH=/me-platform
MAX_REQUEST_SIZE=10mb

# Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Email (SMTP) — required for welcome emails, password reset, and notifications
# Leave blank to disable email sending (emails will be logged to the server log instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=AWYAD MES <noreply@awyad-mes.org>
APP_URL=https://awyad.3bs.ltd

# CSV Data Paths
DATA_DIR=./data
CSV_ENCODING=utf-8
